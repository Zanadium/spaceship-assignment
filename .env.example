# ──────────────────────────────────────────────────────────────────────────────
# spaceship-assignment — root .env.example
#
# Copy to `.env` (gitignored) and fill in real values.
# In production, set these as environment variables in Coolify — never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# New database `spaceship_analytics` on the shared Postgres server.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=<mode>
DATABASE_URL="postgresql://USER:PASSWORD@103.93.163.10:35432/spaceship_analytics?sslmode=disable"

# ── OpenAI (AI orchestration layer) ───────────────────────────────────────────
# Leave blank to run with the deterministic mock router (app stays fully usable).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── Auth (simple shared login) ────────────────────────────────────────────────
# Single shared credential handed to reviewers. Document these in the README.
APP_USERNAME="reviewer"
APP_PASSWORD="CHANGE_ME"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="CHANGE_ME"

# ── API server ────────────────────────────────────────────────────────────────
PORT="3000"
# Comma-separated allowed origins for CORS (the deployed web URL).
FE_ORIGIN="http://localhost:5173"

# ── Web (Vite, build-time) ────────────────────────────────────────────────────
# Base URL of the API the frontend talks to.
VITE_API_URL="http://localhost:3000"
# Optional: prefill the login form for reviewers (should match APP_USERNAME/APP_PASSWORD).
VITE_DEMO_USERNAME="reviewer"
VITE_DEMO_PASSWORD="CHANGE_ME"
